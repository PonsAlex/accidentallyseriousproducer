# Copie para .env e preencha apenas a credencial da rota que você usa.
# O .env é ignorado pelo Git; nunca faça commit de uma chave real.

# Rota direta TypeSafe (endpoint https://api.typesafe.ai/v1/systemone, modelo jev-latest)
TYPESAFE_API_KEY=

# Rota Vercel AI Gateway (endpoint https://ai-gateway.vercel.sh/typesafe/v1/systemone, modelo typesafe-ai/jev)
AI_GATEWAY_API_KEY=

# Opcionais. JEV_API_KEY sobrepõe a credencial; JEV_ROUTE aceita typesafe, ai-gateway ou custom.
# JEV_API_KEY=
# JEV_ROUTE=
# JEV_BASE_URL=
# JEV_MODEL=
